<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodeMaster.McpServer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Seed\**" />
    <None Remove="Seed\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeMaster.LocalAgent\CodeMaster.LocalAgent.csproj" />
    <ProjectReference Include="..\CodeMaster.UiComposition\CodeMaster.UiComposition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="..\CodeMaster.CodeGenerator\Templates\**\*.*">
      <Link>CodeMaster.CodeGenerator\Templates\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>


  <Target Name="ValidatePrintingLocalAgentMcpModule"
          BeforeTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and !Exists('..\CodeMaster.Private\Printing.LocalAgent\CodeMaster.Printing.LocalAgent.csproj')">
    <Error Text="CodeMaster Full edition requires the printing LocalAgent module." />
  </Target>


  <Target Name="BuildPrintingLocalAgentMcpModule"
          BeforeTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and Exists('..\CodeMaster.Private\Printing.LocalAgent\CodeMaster.Printing.LocalAgent.csproj')">
    <MSBuild Projects="..\CodeMaster.Private\Printing.LocalAgent\CodeMaster.Printing.LocalAgent.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);SkipPrintingLocalAgentCopy=true" />
  </Target>


  <Target Name="PublishPrintingLocalAgentMcpModule"
          AfterTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and Exists('..\CodeMaster.Private\Printing.LocalAgent\CodeMaster.Printing.LocalAgent.csproj')">
    <ItemGroup>
      <PrintingLocalAgentMcpFiles Include="..\CodeMaster.Private\Printing.LocalAgent\bin\$(Configuration)\$(TargetFramework)\CodeMaster.Printing.LocalAgent.dll" />
      <PrintingRuntimeMcpFiles Include="$(TargetDir)modules\CodeMaster.PrintingRuntime\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)modules" />
    <Copy SourceFiles="@(PrintingLocalAgentMcpFiles)" DestinationFolder="$(PublishDir)modules" />
    <MakeDir Directories="$(PublishDir)modules\CodeMaster.PrintingRuntime" />
    <Copy SourceFiles="@(PrintingRuntimeMcpFiles)"
          DestinationFiles="@(PrintingRuntimeMcpFiles->'$(PublishDir)modules\CodeMaster.PrintingRuntime\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
