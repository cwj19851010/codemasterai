<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeMaster.Agent\CodeMaster.Agent.csproj" />
    <ProjectReference Include="..\CodeMaster.Application\CodeMaster.Application.csproj" />
    <ProjectReference Include="..\CodeMaster.Infrastructure\CodeMaster.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\CodeMaster.CodeGenerator\Templates\**\*.*">
      <Link>CodeMaster.CodeGenerator\Templates\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateUiCompositionLocalAgentModule"
          BeforeTargets="Publish"
          Condition="!Exists('..\CodeMaster.UiComposition.LocalAgent\CodeMaster.UiComposition.LocalAgent.csproj')">
    <Error Text="Missing CodeMaster.UiComposition.LocalAgent project; the working tree is incomplete." />
  </Target>

  <Target Name="ValidatePrintingLocalAgentModule"
          BeforeTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and !Exists('..\CodeMaster.Private\Printing.LocalAgent\CodeMaster.Printing.LocalAgent.csproj')">
    <Error Text="CodeMaster Full edition requires the CodeMaster.Private printing LocalAgent module." />
  </Target>

  <Target Name="BuildUiCompositionLocalAgentModule"
          BeforeTargets="Publish"
          Condition="Exists('..\CodeMaster.UiComposition.LocalAgent\CodeMaster.UiComposition.LocalAgent.csproj')">
    <MSBuild Projects="..\CodeMaster.UiComposition.LocalAgent\CodeMaster.UiComposition.LocalAgent.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);SkipUiCompositionWebApiCopy=true"
             RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSingleFile;PublishTrimmed;IncludeNativeLibrariesForSelfExtract" />
  </Target>

  <Target Name="BuildPrintingLocalAgentModule"
          BeforeTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and Exists('..\CodeMaster.Private\Printing.LocalAgent\CodeMaster.Printing.LocalAgent.csproj')">
    <MSBuild Projects="..\CodeMaster.Private\Printing.LocalAgent\CodeMaster.Printing.LocalAgent.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSingleFile;PublishTrimmed;IncludeNativeLibrariesForSelfExtract" />
  </Target>

  <Target Name="PublishUiCompositionLocalAgentModule"
          AfterTargets="Publish"
          Condition="Exists('..\CodeMaster.UiComposition.LocalAgent\CodeMaster.UiComposition.LocalAgent.csproj')">
    <ItemGroup>
      <UiCompositionLocalAgentFiles Include="..\CodeMaster.UiComposition\bin\$(Configuration)\$(TargetFramework)\CodeMaster.UiComposition.dll" />
      <UiCompositionLocalAgentFiles Include="..\CodeMaster.UiComposition\bin\$(Configuration)\$(TargetFramework)\Microsoft.OpenApi.dll" />
      <UiCompositionLocalAgentFiles Include="..\CodeMaster.UiComposition\bin\$(Configuration)\$(TargetFramework)\Microsoft.OpenApi.Readers.dll" />
      <UiCompositionLocalAgentFiles Include="..\CodeMaster.UiComposition\bin\$(Configuration)\$(TargetFramework)\SharpYaml.dll" />
      <UiCompositionLocalAgentFiles Include="..\CodeMaster.UiComposition.LocalAgent\bin\$(Configuration)\$(TargetFramework)\CodeMaster.UiComposition.LocalAgent.dll" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)modules" />
    <Copy SourceFiles="@(UiCompositionLocalAgentFiles)" DestinationFolder="$(PublishDir)modules" />
  </Target>

  <Target Name="PublishPrintingLocalAgentModule"
          AfterTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and Exists('..\CodeMaster.Private\Printing.LocalAgent\CodeMaster.Printing.LocalAgent.csproj')">
    <ItemGroup>
      <PrintingLocalAgentFiles Include="..\CodeMaster.Private\Printing.LocalAgent\bin\$(Configuration)\$(TargetFramework)\CodeMaster.Printing.LocalAgent.dll" />
      <PrintingRuntimeBundleFiles Include="$(TargetDir)modules\CodeMaster.PrintingRuntime\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)modules" />
    <Copy SourceFiles="@(PrintingLocalAgentFiles)" DestinationFolder="$(PublishDir)modules" />
    <MakeDir Directories="$(PublishDir)modules\CodeMaster.PrintingRuntime" />
    <Copy SourceFiles="@(PrintingRuntimeBundleFiles)"
          DestinationFiles="@(PrintingRuntimeBundleFiles->'$(PublishDir)modules\CodeMaster.PrintingRuntime\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
