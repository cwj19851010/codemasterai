<div class="md-toolbar" role="toolbar" aria-label="Markdown 工具栏">
    <button type="button" class="md-tool" data-md="bold" title="加粗"><strong>B</strong></button>
    <button type="button" class="md-tool" data-md="italic" title="斜体"><em>I</em></button>
    <button type="button" class="md-tool" data-md="code" title="行内代码"><code>&lt;/&gt;</code></button>
    <button type="button" class="md-tool" data-md="link" title="插入链接">链接</button>
    <button type="button" class="md-tool" data-md="quote" title="引用">引用</button>
    <button type="button" class="md-tool" data-md="list" title="无序列表">列表</button>
    <button type="button" class="md-tool" data-md="codeblock" title="代码块">代码块</button>
    <span class="md-spacer"></span>
    <div class="md-tabs">
        <button type="button" class="active" data-md-tab="write">编辑</button>
        <button type="button" data-md-tab="preview">预览</button>
    </div>
</div>
