@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    var swaggerEnabled = HostEnvironment.IsDevelopment() || Configuration.GetValue("Swagger:Enabled", false);
    var clientDownloadUrl = ViewData["ClientDownloadUrl"] as string ?? "/download/client/windows/latest";
    var clientDownloadVersion = ViewData["ClientDownloadVersion"] as string;
    var clientDownloadSize = ViewData["ClientDownloadSize"] as string;
    var githubRepositoryUrl = "https://github.com/cwj19851010/code-master";
    var giteeRepositoryUrl = "https://gitee.com/cwj19851010/code-master";
    var clientVersionLabel = string.IsNullOrWhiteSpace(clientDownloadVersion) ? "等待上传最新版" : $"最新版 v{clientDownloadVersion}";
    var clientVersionMeta = string.IsNullOrWhiteSpace(clientDownloadSize) ? clientVersionLabel : $"{clientVersionLabel} · {clientDownloadSize}";
    ViewData["Title"] = "CodeMaster - 从低代码工具到 AI 原生 .NET 开发平台";
    ViewData["Description"] = "CodeMaster 是支持私有化部署的 .NET 10 + Vue 3 开发平台，提供干净框架导出、动态 API、EF 迁移、完整 Element Plus 可视化设计、MCP 与内置 Agent。";
}

@section Head {
    <meta name="keywords" content="CodeMaster,.NET 10,Vue 3,低代码平台,AI Agent,智能体,动态API,代码生成,权限生成,EF迁移,Element Plus,MCP,Codex,Claude Code,Tauri,私有化部署" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "SoftwareApplication",
      "name": "CodeMaster",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Windows, Linux, macOS",
      "softwareVersion": "@(clientDownloadVersion ?? "preview")",
      "description": "Self-hosted AI-native .NET 10 and Vue 3 development platform with clean template export, dynamic APIs, EF migrations, full Element Plus visual design, MCP workflows and a built-in Agent.",
      "programmingLanguage": ["C#", ".NET", "Vue", "JavaScript"],
      "sameAs": [
        "@githubRepositoryUrl",
        "@giteeRepositoryUrl"
      ],
      "featureList": [
        "Convention-based dynamic API generation",
        "Automatic menu and permission generation",
        "EF Core migrations and seed data generation",
        "Full and incremental .NET and Vue code generation",
        "Clean framework template export from the current CodeMaster source",
        "Visual entity and page designer",
        "MCP workflows for Codex and Claude Code",
        "Built-in approval-based CodeMaster Agent",
        "Multi-tenant enterprise application foundation",
        "Private deployment"
      ],
      "downloadUrl": "@clientDownloadUrl",
      "offers": { "@@type": "Offer", "price": "0", "priceCurrency": "USD" }
    }
    </script>
}

<section class="hero home-hero">
    <div class="hero-copy">
        <p class="eyebrow">Data-driven engineering platform</p>
        <h1>CodeMaster</h1>
        <p class="hero-slogan">数据定义一次，工程生成始终。</p>
        <p class="hero-lead">
            CodeMaster 把项目、模块、实体、字段、关系与模板整理成一份工程蓝图，再驱动 API、权限、迁移、页面和前后端代码持续产出。生成的是真实代码，而不是演示页。
        </p>
        <div class="hero-actions">
            <a class="button primary" href="/register">开始使用</a>
            <a class="button secondary" href="@clientDownloadUrl">下载客户端</a>
            <span class="client-version-pill">@clientVersionMeta</span>
            <a class="button repo github-repo" href="@githubRepositoryUrl" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="button repo gitee-repo" href="@giteeRepositoryUrl" target="_blank" rel="noopener noreferrer">Gitee</a>
            @if (swaggerEnabled)
            {
                <a class="button ghost" href="/swagger">API 文档</a>
            }
        </div>
        <dl class="hero-stats">
            <div><dt>元数据驱动</dt><dd>实体、字段、关系、模板</dd></div>
            <div><dt>全量 + 增量</dt><dd>一次成型，持续演进</dd></div>
            <div><dt>真实代码</dt><dd>可阅读、调试、独立部署</dd></div>
            <div><dt>私有化部署</dt><dd>源码、模型与数据自持</dd></div>
        </dl>
    </div>
</section>

<section class="section data-core">
    <div class="section-head wide">
        <p class="eyebrow">One blueprint, every artifact</p>
        <h2>一份元数据，贯通 API、权限、数据库与前端</h2>
        <p>实体结构一旦定义，CodeMaster 就按同一套约定持续产出工程产物。之后字段、排序、子表和模板的任何变化，都能再次进入可重复执行的生成链路。</p>
    </div>
    <div class="data-flow">
        <div class="data-source">
            <h3>定义蓝图</h3>
            <p>项目 · 模块 · 实体 · 字段 · 关联 · 控件属性</p>
            <div class="data-tokens">
                <span>项目</span><span>模块</span><span>实体</span><span>字段</span><span>关系</span><span>模板</span>
            </div>
        </div>
        <div class="data-engine">
            <strong>CodeGen 引擎</strong>
            <span>约定推导 · 全量/增量</span>
        </div>
        <ul class="data-outputs">
            <li><strong>动态 API 与权限</strong><p>服务自动注册为 REST 接口，菜单、权限、按钮与租户范围同步生成。</p></li>
            <li><strong>数据库迁移与种子</strong><p>EF Core Migrator 建表建库，初始化菜单、字典、语言与基础数据。</p></li>
            <li><strong>前后端代码</strong><p>领域实体、DTO、服务、API 调用、查询列表、编辑与详情页一次输出。</p></li>
            <li><strong>独立部署工程</strong><p>生成项目自带源码与迁移，可单独开发、构建、测试与交付。</p></li>
        </ul>
    </div>
</section>

<section class="section capabilities-section">
    <div class="feature-grid">
        <article>
            <strong>干净框架导出</strong>
            <p>从 CodeMaster 当前源码导出纯净模板，剥离平台元数据与历史迁移，新项目可独立维护。</p>
        </article>
        <article>
            <strong>完整页面设计器</strong>
            <p>基于 Element Plus 的拖拽设计。稳定节点 ID 让布局、脚本与 Agent 修改可以持续重放。</p>
        </article>
        <article>
            <strong>MCP + 内置 Agent</strong>
            <p>Codex、Claude Code 通过 MCP 协作；内置 Agent 读取蓝图、提交审批、执行生成并做真实构建验证。</p>
        </article>
        <article>
            <strong>企业基础能力</strong>
            <p>用户、角色、部门、多租户、数据权限、字典、多语言、定时任务与 SignalR 通知开箱即用。</p>
        </article>
    </div>
</section>

<section class="section product-section">
    <div class="product-gallery">
        <figure class="product-shot product-shot-wide">
            <img src="/site/images/product-template-config.png" alt="CodeMaster 页面模板与控件模板配置界面" loading="lazy" />
            <figcaption><strong>项目与模板</strong><span>页面、控件与子表模板可在线维护，并通过迁移和更新脚本保持环境一致。</span></figcaption>
        </figure>
        <figure class="product-shot">
            <img src="/site/images/product-entity-designer.png" alt="CodeMaster 实体页面设计器" loading="lazy" />
            <figcaption><strong>实体页面设计器</strong><span>直接查看组件树、页面结构和脚本区段，完成细粒度页面调整。</span></figcaption>
        </figure>
        <figure class="product-shot">
            <img src="/site/images/product-project-list.png" alt="CodeMaster 项目实体管理与代码生成操作界面" loading="lazy" />
            <figcaption><strong>从实体到代码</strong><span>围绕实体执行设计、增量生成、全量生成、菜单和多语言同步。</span></figcaption>
        </figure>
    </div>
</section>

<section class="section faq">
    <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>关于 CodeMaster</h2>
    </div>
    <details open><summary>CodeMaster 和传统后台管理框架有什么不同？</summary><p>传统后台框架提供一套现成模块；CodeMaster 关注持续生产能力。元数据、动态 API、迁移、模板、全量与增量生成、MCP 与本地客户端共同组成一条可反复运行的工程链路。</p></details>
    <details><summary>生成出来的项目是否依赖 CodeMaster？</summary><p>不依赖。生成项目拥有独立源码、数据库迁移和运行配置，可以单独开发、部署和交付；CodeMaster 负责生产和更新工程，不是业务系统的运行时前置条件。</p></details>
    <details><summary>CodeMaster 支持私有化部署吗？</summary><p>支持。平台服务、前端、数据库、模板、Agent 供应商配置与生成项目都可以部署在自己的服务器或内网环境。</p></details>
    <details><summary>CodeMaster Agent 和普通代码助手有什么不同？</summary><p>普通代码助手主要根据当前文件猜测修改；CodeMaster Agent 先绑定项目，读取完整业务蓝图，再提交结构化变更等待审批，执行后触发真实生成与构建验证。</p></details>
</section>

<section class="home-cta">
    <div>
        <p class="eyebrow">Start building</p>
        <h2>从第一个实体开始，生成你的业务系统</h2>
        <p>使用 Web 平台管理模型，通过 MCP 连接 Codex、Claude Code，或直接让内置 Agent 按项目规则完成建模、页面优化、生成与构建。</p>
    </div>
    <div class="hero-actions">
        <a class="button primary" href="/register">创建账号</a>
        <a class="button secondary" href="/download">下载 CodeMaster</a>
        <a class="button repo github-repo" href="@githubRepositoryUrl" target="_blank" rel="noopener noreferrer">GitHub 仓库</a>
        <a class="button repo gitee-repo" href="@giteeRepositoryUrl" target="_blank" rel="noopener noreferrer">Gitee 仓库</a>
    </div>
</section>