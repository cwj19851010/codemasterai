<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- Microsoft.Playwright (the private printing module) requires assembly version 6.0.0.0.
         Keep the host on the same assembly version so optional modules can load in the
         default AssemblyLoadContext without a Microsoft.Bcl.AsyncInterfaces mismatch. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="6.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="System.ClientModel" Version="1.10.0" />
  </ItemGroup>

  <Target Name="ValidateCodeMasterVue"
          BeforeTargets="Publish"
          Condition="'$(SkipCodeMasterVueBuild)' != 'true' and !Exists('..\CodeMaster.Vue\package.json')">
    <Error Text="CodeMaster publish requires the CodeMaster.Vue directory. Set SkipCodeMasterVueBuild=true only for a backend-only publish." />
  </Target>

  <Target Name="BuildCodeMasterVue"
          BeforeTargets="Publish"
          Condition="'$(SkipCodeMasterVueBuild)' != 'true' and Exists('..\CodeMaster.Vue\package.json')">
    <Exec Condition="!Exists('..\CodeMaster.Vue\node_modules')"
          WorkingDirectory="..\CodeMaster.Vue"
          Command="npm install" />
    <Exec WorkingDirectory="..\CodeMaster.Vue"
          Command="npm run $(CodeMasterVueBuildScript)" />
  </Target>

  <Target Name="PublishCodeMasterVue"
          AfterTargets="Publish"
          Condition="'$(SkipCodeMasterVueBuild)' != 'true' and Exists('..\CodeMaster.Vue\dist\index.html')">
    <ItemGroup>
      <CodeMasterVueFiles Include="..\CodeMaster.Vue\dist\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)wwwroot\assets" />
    <Delete Files="$(PublishDir)wwwroot\index.html" />
    <MakeDir Directories="$(PublishDir)wwwroot" />
    <Copy SourceFiles="@(CodeMasterVueFiles)"
          DestinationFiles="@(CodeMasterVueFiles->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\CodeMaster.Agent\CodeMaster.Agent.csproj" />
    <ProjectReference Include="..\CodeMaster.Application\CodeMaster.Application.csproj" />
    <ProjectReference Include="..\CodeMaster.Infrastructure\CodeMaster.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Templates/latest-template.txt is written by TemplateExportService on every export.
         Only the package it names is shipped; historical exports stay out of bin/ and publish/.
         When the pointer is absent (fresh clone / older tree) fall back to every package. -->
    <CodeMasterTemplatePointerPath>$(MSBuildThisFileDirectory)..\Templates\latest-template.txt</CodeMasterTemplatePointerPath>
    <CodeMasterCurrentTemplateZip Condition="Exists('$(CodeMasterTemplatePointerPath)')">$([System.IO.File]::ReadAllText('$(CodeMasterTemplatePointerPath)').Trim())</CodeMasterCurrentTemplateZip>
  </PropertyGroup>

  <ItemGroup Condition="'$(CodeMasterCurrentTemplateZip)' != ''">
    <Content Include="..\Templates\$(CodeMasterCurrentTemplateZip)">
      <Link>Templates\$(CodeMasterCurrentTemplateZip)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(CodeMasterCurrentTemplateZip)' == ''">
    <Content Include="..\Templates\CodeMaster_Template_*.zip">
      <Link>Templates\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\CodeMaster.CodeGenerator\Templates\**\*.*">
      <Link>CodeMaster.CodeGenerator\Templates\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateFullEditionModules"
          BeforeTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and !Exists('..\CodeMaster.Private\UiComposition\CodeMaster.UiComposition.csproj')">
    <Error Text="CodeMaster Full edition requires the CodeMaster.Private directory." />
  </Target>

  <Target Name="ValidatePrintingModule"
          BeforeTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and !Exists('..\CodeMaster.Private\Printing\CodeMaster.Printing.csproj')">
    <Error Text="CodeMaster Full edition requires the Printing private module." />
  </Target>

  <Target Name="BuildUiCompositionModules"
          BeforeTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and Exists('..\CodeMaster.Private\UiComposition\CodeMaster.UiComposition.csproj')">
    <MSBuild Projects="..\CodeMaster.Private\UiComposition\CodeMaster.UiComposition.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);SkipUiCompositionWebApiCopy=true" />
    <MSBuild Projects="..\CodeMaster.Private\UiComposition.Agent\CodeMaster.UiComposition.Agent.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);SkipUiCompositionWebApiCopy=true" />
  </Target>

  <Target Name="BuildPrintingModule"
          BeforeTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and Exists('..\CodeMaster.Private\Printing\CodeMaster.Printing.csproj')">
    <MSBuild Projects="..\CodeMaster.Private\Printing\CodeMaster.Printing.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <!-- 小程序与生成物 AI 是 2026-10 从 Application 里搬出来的独立模块。
       Build 时它们自己会往 bin/.../modules 拷一份；这里补上 Publish 前的构建，
       否则 dotnet publish 不会带上它们。 -->
  <Target Name="BuildMiniAppModule"
          BeforeTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and Exists('..\CodeMaster.Private\MiniApp\CodeMaster.GeneratedMiniApp.csproj')">
    <MSBuild Projects="..\CodeMaster.Private\MiniApp\CodeMaster.GeneratedMiniApp.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="BuildGeneratedProjectAiModule"
          BeforeTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and Exists('..\CodeMaster.Private\GeneratedProjectAi\CodeMaster.GeneratedProjectAi.csproj')">
    <MSBuild Projects="..\CodeMaster.Private\GeneratedProjectAi\CodeMaster.GeneratedProjectAi.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="PublishUiCompositionModules"
          AfterTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and Exists('..\CodeMaster.Private\UiComposition\CodeMaster.UiComposition.csproj')">
    <ItemGroup>
      <UiModuleFiles Include="..\CodeMaster.Private\UiComposition\bin\$(Configuration)\$(TargetFramework)\CodeMaster.UiComposition.dll" />
      <UiModuleFiles Include="..\CodeMaster.Private\UiComposition\bin\$(Configuration)\$(TargetFramework)\Microsoft.OpenApi.dll" />
      <UiModuleFiles Include="..\CodeMaster.Private\UiComposition\bin\$(Configuration)\$(TargetFramework)\Microsoft.OpenApi.Readers.dll" />
      <UiModuleFiles Include="..\CodeMaster.Private\UiComposition\bin\$(Configuration)\$(TargetFramework)\SharpYaml.dll" />
      <UiModuleFiles Include="..\CodeMaster.Private\UiComposition.Agent\bin\$(Configuration)\$(TargetFramework)\CodeMaster.UiComposition.Agent.dll" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)modules" />
    <Copy SourceFiles="@(UiModuleFiles)" DestinationFolder="$(PublishDir)modules" />
  </Target>

  <Target Name="PublishFullEditionModuleDirectory"
          AfterTargets="Publish"
          Condition="'$(IncludePrivateModules)' == 'true' and Exists('$(TargetDir)modules')">
    <ItemGroup>
      <FullEditionModuleFiles Include="$(TargetDir)modules\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FullEditionModuleFiles)"
          DestinationFiles="@(FullEditionModuleFiles->'$(PublishDir)modules\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RemoveUiCompositionModulesFromPublicPublish"
          AfterTargets="Publish"
          Condition="'$(IncludePrivateModules)' != 'true'">
    <ItemGroup>
      <PublicPublishPrivateFiles Include="$(PublishDir)modules\CodeMaster.UiComposition.dll" />
      <PublicPublishPrivateFiles Include="$(PublishDir)modules\CodeMaster.UiComposition.Agent.dll" />
      <PublicPublishPrivateFiles Include="$(PublishDir)modules\Microsoft.OpenApi.dll" />
      <PublicPublishPrivateFiles Include="$(PublishDir)modules\Microsoft.OpenApi.Readers.dll" />
      <PublicPublishPrivateFiles Include="$(PublishDir)modules\SharpYaml.dll" />
    </ItemGroup>
    <Delete Files="@(PublicPublishPrivateFiles)" />
  </Target>

</Project>
