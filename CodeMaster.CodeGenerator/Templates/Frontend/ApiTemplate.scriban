import request from '@/utils/request'

{{~ for related in entity.related_imports ~}}
// 引入{{ related.entity_name }}的不分页列表 API
import { getList as get{{ related.entity_name }}List } from '@/api/{{ related.module_name_all_lower }}/{{ related.entity_name_all_lower }}'
{{~ end ~}}

{{~ for field in entity.remote_select_fields ~}}
// {{ field.name }} remote-select options
export function {{ field.options_api_name }}(parentValue) {
  return request({
    url: '/{{ entity.module_name_all_lower }}/{{ entity.name_all_lower }}/{{ field.options_route }}',
    method: 'get',
    params: parentValue === undefined || parentValue === null || parentValue === '' ? {} : { parentValue }
  })
}

// Batch-resolve {{ field.name }} labels for list/detail pages
export function {{ field.labels_api_name }}(values) {
  return request({
    url: '/{{ entity.module_name_all_lower }}/{{ entity.name_all_lower }}/{{ field.labels_route }}',
    method: 'post',
    data: values
  })
}
{{~ end ~}}

// 获取分页列表
export function getPagedList(params) {
  return request({
    url: '/{{ entity.module_name_all_lower }}/{{ entity.name_all_lower }}/getpagedlist',
    method: 'get',
    params
  })
}

// 获取不分页列表（关联表引用）
export function getList(params) {
  return request({
    url: '/{{ entity.module_name_all_lower }}/{{ entity.name_all_lower }}/getlist',
    method: 'get',
    params
  })
}

{{~ if entity.has_primary_key ~}}
// 获取详情
export function getById(id) {
  return request({
    url: `/{{ entity.module_name_all_lower }}/{{ entity.name_all_lower }}/getbyid/${id}`,
    method: 'get'
  })
}
{{~ if entity.is_read_only ~}}
// 获取详情（只读数据源别名）
export function getDetail(id) {
  return request({
    url: `/{{ entity.module_name_all_lower }}/{{ entity.name_all_lower }}/getdetail/${id}`,
    method: 'get'
  })
}
{{~ end ~}}
{{~ end ~}}

{{~ if entity.is_read_only ~}}
// 获取选项列表
export function getOptionList(params) {
  return request({
    url: '/{{ entity.module_name_all_lower }}/{{ entity.name_all_lower }}/getoptionlist',
    method: 'get',
    params
  })
}
{{~ end ~}}

{{~ if !entity.is_read_only ~}}
// 创建
export function create(data) {
  return request({
    url: '/{{ entity.module_name_all_lower }}/{{ entity.name_all_lower }}/create',
    method: 'post',
    data
  })
}

// 更新
export function update(id, data) {
  return request({
    url: `/{{ entity.module_name_all_lower }}/{{ entity.name_all_lower }}/update/${id}`,
    method: 'put',
    data
  })
}

// 删除
export function deleteById(id) {
  return request({
    url: `/{{ entity.module_name_all_lower }}/{{ entity.name_all_lower }}/delete/${id}`,
    method: 'delete'
  })
}
{{~ end ~}}
